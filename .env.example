# ── Supabase ────────────────────────────────────────────────────────────────
# Valori pubblici: finiscono nel bundle dell'app ed e' normale che sia cosi'.
SUPABASE_URL=https://mjzjracjadlybvdttgto.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# ATTENZIONE: questa chiave bypassa le policy RLS e da' accesso a tutto il
# database. Vive solo sul server di apps/web. Mai nell'app, mai in una
# variabile con prefisso NEXT_PUBLIC_ o EXPO_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Indirizzi pubblici ──────────────────────────────────────────────────────
# Dominio ancora da decidere: in sviluppo si usa localhost.
# Da qui nascono i link delle landing e i QR: nomeapp.it/v/{codice}
DOMINIO_LANDING=http://localhost:3000
