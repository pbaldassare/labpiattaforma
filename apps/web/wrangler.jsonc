{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "labpiattaforma-landing",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Il worker richiama se stesso per le rivalidazioni: il nome deve
    // coincidere con "name" qui sopra.
    { "binding": "WORKER_SELF_REFERENCE", "service": "labpiattaforma-landing" }
  ],
  // Le foto degli annunci passano da next/image: senza questo collegamento
  // Cloudflare non saprebbe ridimensionarle.
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true }
}
