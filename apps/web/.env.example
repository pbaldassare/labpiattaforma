SUPABASE_URL=https://mjzjracjadlybvdttgto.supabase.co

# Chiave pubblicabile: basta alle landing, perche' tutto cio' che mostrano
# passa da venditori.dati_pagina, che filtra i dati interni.
SUPABASE_PUBLISHABLE_KEY=

# Serve solo alle operazioni che nessun ruolo pubblico puo' fare (Fase 2 in poi).
# Bypassa tutte le policy: mai con prefisso NEXT_PUBLIC_, mai in un file "use client".
SUPABASE_SERVICE_ROLE_KEY=

DOMINIO_LANDING=http://localhost:3000

# La pagina di reimpostazione password gira nel browser: il token di recupero
# arriva nel frammento dell'indirizzo, che al server non arriva mai. La chiave
# pubblicabile e' fatta per stare in chiaro — e' la stessa che l'app porta
# dentro di se'. La chiave di servizio qui sopra, mai.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
